#!/usr/bin/python3

import sys

current_char = None
count = 0

for line in sys.stdin:

    char, value = line.strip().split("\t")
    value = int(value)

    if current_char == char:
        count += value

    else:

        if current_char:
            print(f"{current_char}\t{count}")

        current_char = char
        count = value

if current_char:
    print(f"{current_char}\t{count}")

