#!/usr/bin/python3

import sys
import heapq

freq = {}
N = 3

for line in sys.stdin:

    word, count = line.strip().split("\t")
    count = int(count)

    freq[word] = freq.get(word, 0) + count

least_words = heapq.nsmallest(N, freq.items(), key=lambda x: x[1])

for word, count in least_words:
    print(f"{word}\t{count}")