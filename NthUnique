#!/usr/bin/python3

import sys
import heapq

freq = {}
N = 2

for line in sys.stdin:

    word, count = line.strip().split("\t")
    count = int(count)

    freq[word] = freq.get(word, 0) + count

top_words = heapq.nlargest(N, freq.items(), key=lambda x: x[1])

if len(top_words) >= N:
    word, count = top_words[-1]
    print(f"{word}\t{count}")

//nth least freq
